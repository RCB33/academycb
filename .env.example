# Public Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key. Never prefix it with NEXT_PUBLIC_ or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical public origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.example
